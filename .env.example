# LAEX Media Pipeline. Copy to .env.local only after CEO approval.
LAEX_MEDIA_PROVIDER=disabled
PHOTOROOM_API_KEY=

# LAEX Business Platform production-only secrets (never commit real values)
BUSINESS_SESSION_SECRET=
BUSINESS_DATABASE_PATH=
LAEX_CONTROL_PLANE_SECRET=
LAEX_CONTROL_PLANE_PASSWORD=
BUSINESS_DATABASE_URL=
BUSINESS_DATABASE_DIRECT_URL=
BUSINESS_LAB_DATABASE_PATH=.data/business-engine.sqlite
BUSINESS_LAB_SESSION_SECRET=
BUSINESS_BACKUP_RETENTION_DAYS=30
BUSINESS_ALLOW_INSECURE_LOCAL_FALLBACK=false
BUSINESS_DEPLOYMENT_MODE=saas

# Public origins and reversible production routing. Keep disabled until DNS/SSL are ready.
LAEX_PUBLIC_ORIGIN=https://laexapp.com
LF_PRINTER_PUBLIC_ORIGIN=https://lfprinterapp.com
COMMERCE_REFERENCE_COMPANY_SLUG=
LAEX_MULTIDOMAIN_ROUTING_ENABLED=false
LAEX_PUBLIC_INDEXING_ENABLED=false
LAEX_LEGACY_REDIRECT_ENABLED=false
LAEX_LEGACY_HOSTS=
LAEX_ADDITIONAL_ALLOWED_HOSTS=

# Canva must be registered exactly in Canva before changing the active value.
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/canva/callback
# Production override in Vercel: https://laexapp.com/api/integrations/canva/callback
